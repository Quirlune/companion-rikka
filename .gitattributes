# Keep Windows checkouts and upstream diffs consistent.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
# Baseline Profile 生成文件：标记为文本，统一使用 LF 换行，避免 CRLF 抖动
app/src/release/generated/baselineProfiles/*.txt text eol=lf
